# =============================================================================
#  Quizmoo environment
# =============================================================================
#  Copy this file to .env and fill in the values.
#  The server reads .env only when it starts: restart `pnpm dev` / `pnpm dev:lan`
#  after any change here.
#
#  Lines starting with # are switched off; remove the # to switch a line on.
#  Never commit .env: it holds the session secret.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Server and database (required)
# -----------------------------------------------------------------------------

# Port the API, the sockets and (in production) the web app listen on.
PORT=3000

# Postgres connection. This value matches the database of `pnpm db:up`.
DATABASE_URL=postgres://quizmoo:quizmoo@localhost:5432/quizmoo

# Signs the host login sessions. At least 32 random characters.
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the app, used in QR codes and join links (no trailing slash).
# `pnpm dev:lan` sets this to the laptop's wifi address by itself.
APP_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
#  2. Data retention (optional, defaults shown)
# -----------------------------------------------------------------------------

# Finished games older than this many days are deleted automatically.
# RESULTS_RETENTION_DAYS=90

# Finished games kept per host account; finishing one more deletes the oldest.
# MAX_GAMES_PER_HOST=200


# -----------------------------------------------------------------------------
#  3. Host sign-up (optional)
# -----------------------------------------------------------------------------

# true: anyone can sign up as a host on /register with an e-mail address, confirmed
# with a code; no approval. Needs e-mail (below). Budgets on the Users page limit
# what each account may use. Off when unset.
# REGISTRATION_OPEN=true

# E-mail through Brevo's HTTPS API (an EU e-mail provider; Railway's Hobby plan
# blocks SMTP). With these set, hosts log in with one-time codes sent by e-mail
# (admins keep their password), sign-up works, and admins who enter an address in
# My settings > Account hear about new hosts. Unset: username and password logins,
# no sign-up (the venue laptop).
# Brevo is a third-party processor that now receives every host's address: sign its
# data processing agreement first, and for a government or client project have it
# reviewed for compliance.
#   BREVO_API_KEY  an API key from Brevo (SMTP & API > API keys)
#   MAIL_FROM      a sender address verified in Brevo
#   MAIL_PROVIDER  named on the privacy page, e.g. "Brevo (Sendinblue SAS), EU"
# BREVO_API_KEY=
# MAIL_FROM=
# MAIL_PROVIDER=

# Testing only: hand every e-mail to a local Mailpit instead of sending it
# (`pnpm mail:up`, inbox on http://localhost:8025; the e2e suite reads login
# codes there). Local addresses only. Wins over Brevo in development; refused
# together with BREVO_API_KEY in production.
# MAILPIT_URL=http://localhost:8025


# -----------------------------------------------------------------------------
#  4. Public hosting (optional, needed for a site on the internet)
# -----------------------------------------------------------------------------

# Proxies in front of the app whose client address is trusted.
# 1 on Railway or Render. Keep 0 on a laptop or the venue LAN.
# TRUST_PROXY=0

# Who runs this site and where people send privacy requests (privacy page, terms, imprint).
# OPERATOR_NAME=
# OPERATOR_EMAIL=

# The hosting provider and where the data lives, named on the privacy page and imprint,
# e.g. "Railway Corporation, EU West (Amsterdam)". A generic sentence when unset.
# HOSTING_PROVIDER=

# https link for the Feedback item in the host navigation. No item when unset.
# FEEDBACK_URL=


# -----------------------------------------------------------------------------
#  5. First admin account (read only by the seed script)
# -----------------------------------------------------------------------------

# Used once by `pnpm --filter @quizmoo/server seed` to create the first admin.
# Password at least 10 characters. Clear the password after seeding.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=

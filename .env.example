# Server
PORT=3000
DATABASE_URL=postgres://quizmoo:quizmoo@localhost:5432/quizmoo
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin used in QR codes and join links (no trailing slash)
APP_ORIGIN=http://localhost:3000
# Finished games older than this many days are deleted automatically
RESULTS_RETENTION_DAYS=90
# Finished games kept per host account; finishing one more deletes the oldest
MAX_GAMES_PER_HOST=200
# Proxies in front of the app (1 on Railway or Render); leave 0 on a laptop or the venue LAN
# TRUST_PROXY=0
# Shown on the privacy page of a public site: who runs it and where to send requests
# OPERATOR_NAME=
# OPERATOR_EMAIL=
# https link for the Feedback item in the host navigation
# FEEDBACK_URL=
# Let hosts sign up on /register; each account waits for an admin's approval. Off by default.
# REGISTRATION_OPEN=true
# First admin user, read only by the seed script (password at least 10 characters)
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
